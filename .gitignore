# Dependencies
node_modules

# Build output
dist
dist-ssr
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment / secrets — never commit these
.env
.env.*
!.env.example
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Tooling caches
.eslintcache
.cache
.vite
coverage
graphify-out/

# Claude Code local agent state - never part of the deployed project
.claude/

# Runtime-generated data backups — routes/data.js rewrites these on every CSV
# upload, so tracking them makes any upload dirty the working tree.
*.csv.backup

# Scratch / diagnostic files (temporary harnesses, probes, tuning scripts)
probe.mjs
tune.mjs
frontend/public/_*.html
frontend/src/**/_*.js
