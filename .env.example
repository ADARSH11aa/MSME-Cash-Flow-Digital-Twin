# Firebase Web App Configuration for CashTwin (MSME-CashFlow)
# Replace the placeholder values with your Firebase Web App credentials from the Firebase Console:
# Firebase Console > Project Settings > General > Your apps > Web app (SDK setup and configuration)

VITE_FIREBASE_API_KEY=AIzaSyPlaceholderKeyForMSMECashFlow
VITE_FIREBASE_AUTH_DOMAIN=msme-cashflow.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=msme-cashflow
VITE_FIREBASE_STORAGE_BUCKET=msme-cashflow.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
